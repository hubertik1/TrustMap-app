          "stringUnit": {
            "state": "translated",
            "value": "Se guardaron los detalles de la reseña, pero no se completaron los cambios de fotos. Actualiza el lugar e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les détails de l’avis ont été enregistrés, mais les modifications des photos n’ont pas abouti. Actualisez le lieu et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dettagli della recensione sono stati salvati, ma le modifiche alle foto non sono state completate. Aggiorna il luogo e riprova."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os detalhes da avaliação foram guardados, mas as alterações às fotos não foram concluídas. Atualiza o local e tenta novamente."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Подробиці відгуку збережено, але зміни фото не завершено. Оновіть місце та спробуйте знову."
          }
        }
      }
    },
