    "ui.this_permanently_removes_your_profile_reviews_photos_friends_and_private_custom_places_that_no_one_else_uses_t": {
      "comment": "Features/Settings/Views/SettingsView.swift:120",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently removes your profile, reviews, photos, friends, and private custom places that no one else uses. This can’t be undone."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to trwałe usunięcie Twojego profilu, opinii, zdjęć, znajomych i prywatnych własnych miejsc, z których nikt inny nie korzysta. Tej czynności nie można cofnąć."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Profil, Bewertungen, Fotos, Freunde und private eigene Orte, die niemand sonst nutzt, werden dauerhaft gelöscht. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán permanentemente tu perfil, reseñas, fotos, amigos y lugares privados personalizados que nadie más use. No se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre profil, vos avis, photos, amis et lieux privés personnalisés que personne d’autre n’utilise seront définitivement supprimés. Cette action est irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo profilo, recensioni, foto, amici e luoghi privati personalizzati non usati da altri verranno eliminati definitivamente. Questa azione non può essere annullata."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O teu perfil, avaliações, fotos, amigos e locais privados personalizados que mais ninguém usa serão eliminados permanentemente. Esta ação não pode ser anulada."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це назавжди видалить ваш профіль, відгуки, фото, друзів і власні приватні місця, якими ніхто інший не користується. Цю дію неможливо скасувати."
          }
        }
      }
    },
