          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Antwort der Apple-Anmeldung konnte nicht gelesen werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer la respuesta de inicio de sesión con Apple."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire la réponse de connexion avec Apple."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere la risposta di accesso con Apple."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler a resposta de início de sessão com a Apple."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося прочитати відповідь входу через Apple."
          }
        }
      }
    },
    "ui.dish_review_details_were_saved_but_trustmap_could_not_finish_the_photo_changes_refresh_the_place_and_try_again": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dish review details were saved, but TrustMap could not finish the photo changes. Refresh the place and try again."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szczegóły opinii o daniu zostały zapisane, ale zmiany zdjęć nie zostały ukończone. Odśwież miejsce i spróbuj ponownie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Gerichtbewertung wurde gespeichert, aber die Fotoänderungen konnten nicht abgeschlossen werden. Aktualisiere den Ort und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se guardaron los detalles de la reseña del plato, pero no se completaron los cambios de fotos. Actualiza el lugar e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les détails de l’avis sur le plat ont été enregistrés, mais les modifications des photos n’ont pas abouti. Actualisez le lieu et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dettagli della recensione del piatto sono stati salvati, ma le modifiche alle foto non sono state completate. Aggiorna il luogo e riprova."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os detalhes da avaliação do prato foram guardados, mas as alterações às fotos não foram concluídas. Atualiza o local e tenta novamente."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Подробиці відгуку про страву збережено, але зміни фото не завершено. Оновіть місце та спробуйте знову."
          }
        }
      }
    },
