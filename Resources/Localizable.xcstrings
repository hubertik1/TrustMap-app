    "ui.you_won_t_see_each_other_s_content_or_receive_friend_requests_your_friendship_will_be_removed": {
      "comment": "Features/Safety/Views/BlockUserButton.swift:31",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You won't see each other's content or receive friend requests. Your friendship will be removed."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie będziecie widzieć swoich treści ani otrzymywać zaproszeń do znajomych. Wasza znajomość zostanie usunięta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr seht keine Inhalte voneinander und erhaltet keine Freundschaftsanfragen. Eure Freundschaft wird entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No veréis el contenido del otro ni recibiréis solicitudes de amistad. Vuestra amistad se eliminará."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne verrez plus vos contenus respectifs et ne recevrez plus de demandes d’amitié. Votre amitié sera supprimée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non vedrete i contenuti dell’altro né riceverete richieste di amicizia. La vostra amicizia verrà rimossa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixarão de ver o conteúdo um do outro ou receber pedidos de amizade. A vossa amizade será removida."
          }
        },
