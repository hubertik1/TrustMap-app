    "ui.to_disconnect_sign_in_with_apple_open_settings_your_name_sign_in_with_apple_trustmap_then_tap_delete_and_confi": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " To disconnect Sign in with Apple, open Settings > your name > Sign in with Apple > TrustMap, then tap Delete and confirm."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": " Aby odłączyć logowanie przez Apple, otwórz Ustawienia > Twoje imię > Zaloguj się przez Apple > TrustMap, a następnie stuknij Usuń i potwierdź."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Um die Apple-Anmeldung zu trennen, öffne Einstellungen > dein Name > Mit Apple anmelden > TrustMap, tippe auf Löschen und bestätige."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Para desconectar el inicio de sesión con Apple, abre Ajustes > tu nombre > Iniciar sesión con Apple > TrustMap, toca Eliminar y confirma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " Pour dissocier la connexion avec Apple, ouvrez Réglages > votre nom > Connexion avec Apple > TrustMap, touchez Supprimer et confirmez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": " Per scollegare l’accesso con Apple, apri Impostazioni > il tuo nome > Accedi con Apple > TrustMap, tocca Elimina e conferma."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": " Para desligar o início de sessão com a Apple, abre Definições > o teu nome > Iniciar sessão com a Apple > TrustMap, toca em Eliminar e confirma."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": " Щоб від’єднати вхід через Apple, відкрийте Налаштування > ваше ім’я > Вхід з Apple > TrustMap, натисніть Видалити та підтвердьте."
          }
        }
      }
    },
    "ui.trustmap_could_not_read_the_apple_sign_in_response": {
      "comment": "",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TrustMap could not read the Apple sign-in response."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
